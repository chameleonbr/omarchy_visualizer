{
  "schemaVersion": 1,
  "id": "avila.visualizer",
  "name": "Visualizer",
  "version": "1.0.0",
  "author": "Andre Avila",
  "license": "MIT",
  "description": "Audio spectrum in the bar, in five shapes and six palettes, with the same colours mirrored on your WLED lights.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Visualizer",
    "description": "The sound, in the bar. Pauses itself when nothing is playing and when you are on battery.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "shape": "bars",
      "palette": "accent",
      "gradientFrom": "",
      "gradientTo": "",
      "peakThreshold": 85,
      "barCount": 14,
      "segments": 8,
      "framerate": 30,
      "widgetWidth": 90,
      "barWidth": 3,
      "smoothing": 60,
      "floor": 3,
      "pauseOnBattery": true,
      "pauseWhenSilent": true,
      "wledEnabled": false,
      "wledRateHz": 10,
      "wledDevices": "",
      "wledRestore": true,
      "mode": "float"
    },
    "schema": [
      {
        "key": "mode",
        "type": "string",
        "label": "Stage window",
        "description": "float is a layer-shell card over everything; tile is a real window the compositor tiles.",
        "options": [
          "float",
          "tile"
        ],
        "defaultValue": "float"
      },
      {
        "key": "shape",
        "type": "string",
        "label": "Shape",
        "description": "bars and mirror are the loudest; dots barely distracts; wave is the only one that costs a canvas.",
        "options": [
          "bars",
          "mirror",
          "blocks",
          "dots",
          "wave"
        ],
        "defaultValue": "bars"
      },
      {
        "key": "palette",
        "type": "string",
        "label": "Palette",
        "description": "intensity and urgent move with the sound; spectrum and gradient are fixed to position.",
        "options": [
          "accent",
          "foreground",
          "intensity",
          "spectrum",
          "gradient",
          "urgent"
        ],
        "defaultValue": "accent"
      },
      {
        "key": "gradientFrom",
        "type": "string",
        "label": "Gradient from",
        "description": "Hex, for the gradient palette.",
        "defaultValue": ""
      },
      {
        "key": "gradientTo",
        "type": "string",
        "label": "Gradient to",
        "description": "Hex, for the gradient palette.",
        "defaultValue": ""
      },
      {
        "key": "peakThreshold",
        "type": "integer",
        "label": "Peak threshold",
        "description": "Where the urgent palette crosses over.",
        "min": 50,
        "max": 100,
        "step": 5,
        "defaultValue": 85
      },
      {
        "key": "barCount",
        "type": "integer",
        "label": "Bars",
        "min": 6,
        "max": 24,
        "step": 1,
        "defaultValue": 14
      },
      {
        "key": "segments",
        "type": "integer",
        "label": "Segments per bar",
        "description": "For the blocks shape.",
        "min": 3,
        "max": 16,
        "step": 1,
        "defaultValue": 8
      },
      {
        "key": "framerate",
        "type": "integer",
        "label": "Frames per second",
        "description": "30 looks the same as 60 at this size and costs half as much.",
        "min": 10,
        "max": 60,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "widgetWidth",
        "type": "integer",
        "label": "Width (px)",
        "min": 40,
        "max": 300,
        "step": 10,
        "defaultValue": 90
      },
      {
        "key": "barWidth",
        "type": "integer",
        "label": "Bar width (px)",
        "min": 1,
        "max": 8,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "smoothing",
        "type": "integer",
        "label": "Release smoothing",
        "description": "How gently a bar falls. The rise is always immediate.",
        "min": 0,
        "max": 95,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "floor",
        "type": "integer",
        "label": "Silence floor",
        "description": "Below this a bar reads as zero, so room noise does not keep it trembling.",
        "min": 0,
        "max": 20,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "pauseWhenSilent",
        "type": "boolean",
        "label": "Pause when nothing is playing",
        "defaultValue": true
      },
      {
        "key": "pauseOnBattery",
        "type": "boolean",
        "label": "Pause on battery",
        "defaultValue": true
      },
      {
        "key": "wledEnabled",
        "type": "boolean",
        "label": "Mirror onto WLED",
        "description": "Sends brightness and colour to the lights configured for the WLED plugin.",
        "defaultValue": false
      },
      {
        "key": "wledRateHz",
        "type": "integer",
        "label": "WLED updates per second",
        "description": "WLED over HTTP cannot follow the frame rate; above this the lamp stops answering.",
        "min": 1,
        "max": 20,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "wledDevices",
        "type": "string",
        "label": "WLED hosts",
        "description": "Comma separated. Empty means every configured light.",
        "defaultValue": ""
      },
      {
        "key": "wledRestore",
        "type": "boolean",
        "label": "Restore the lights afterwards",
        "description": "Puts them back when the music stops. Leaving a lamp frozen on a colour is the worst thing this can do.",
        "defaultValue": true
      }
    ]
  }
}
